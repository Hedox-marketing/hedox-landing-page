---
import { trustItems } from '../data/content';

const ikony: Record<string, string> = {
  dom: '/images/icon-home.jpeg',
  medaila: '/images/icon-badge.jpeg',
  stit: '/images/icon-shield.jpeg',
  hodiny: '/images/icon-clock.jpeg',
};
---

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 px-4 py-16 md:grid-cols-4">
    {
      trustItems.map((item) => (
        <div class="flex flex-col items-center gap-4 text-center">
          <img src={ikony[item.ikona]} alt="" class="h-[3.8125rem] w-[6.75rem] object-contain" />
          <p class="font-heading text-[18px] font-semibold">
            {item.riadky[0]}<br />{item.riadky[1]}
          </p>
        </div>
      ))
    }
  </div>
</section>
