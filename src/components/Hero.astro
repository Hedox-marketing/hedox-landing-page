---
import { hero } from '../data/content';
---

<section
  class="bg-cover bg-right"
  style="background-image: url('/images/hero-bg.webp')"
>
  <div class="mx-auto max-w-6xl px-4 py-24 md:py-32">
    <div class="max-w-xl">
      <h1 class="font-heading text-[40px] font-bold leading-tight text-neutral-900">
        {hero.nadpisPred}<span class="text-brand">{hero.nadpisZelena}</span>{hero.nadpisPo}
      </h1>
      <p class="mt-8 w-[80%] text-[20px] font-semibold text-[#191919]">{hero.podnadpis}</p>
      <a
        href="#nezavazna-ponuka"
        class="mt-12 inline-block rounded-lg bg-brand-dark px-8 py-4 font-heading text-[20px] font-semibold text-white transition hover:opacity-90"
      >
        {hero.cta}
      </a>
    </div>
  </div>
</section>
