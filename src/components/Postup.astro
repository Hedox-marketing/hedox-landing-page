---
import { postup } from '../data/content';
---

<section class="bg-[linear-gradient(91deg,#859f54,#ffffff)]">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="text-center font-heading text-[46px] font-bold">{postup.nadpis}</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        postup.kroky.map((krok) => (
          <div class="flex flex-col items-center justify-center rounded-[2.1875rem] bg-brand-dark p-6 text-center text-white shadow-lg">
            <h3 class="font-heading text-[18px] font-bold">{krok.titulok}</h3>
            <p class="mt-3 text-[16px] leading-snug">{krok.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
